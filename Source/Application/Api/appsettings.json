{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Adanova": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Api": {
    "Key": "",
    "AllowKeyOnBusinessEndpoints": false,
    "EnableSwagger": false,
    "UseHttpsRedirection": true
  },
  "Migrations": {
    "ApplyAtStartup": false
  },
  "Oidc": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "EmailClaim": "email",
    "GroupsClaim": "groups"
  },
  "Authorization": {
    "RolePermissions": {}
  },
  "Calendar": {
    "FeedToken": "",
    "UidDomain": "adanova83.org",
    "DayOfWeekStartsOnMonday": false
  }
}
