<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Web</RootNamespace>
    <AssemblyName>Web</AssemblyName>
    <!-- Scripts Blazor (_framework/blazor.web.js) : le SDK ne les ajoute que s'il voit des fichiers .razor à la
         restauration ; or le Dockerfile restaure avec les seuls .csproj. On les demande donc explicitement. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Les contrats (Library.Contract) sont partagés avec l'API -->
    <ProjectReference Include="../../Library/Library.csproj" />
  </ItemGroup>

</Project>
