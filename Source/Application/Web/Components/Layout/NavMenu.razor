@* Le menu n'affiche que ce que l'utilisateur peut consulter (*.read) ; l'API fait foi pour les droits. *@
<ul class="nav">
    <li><NavLink href="" Match="NavLinkMatch.All"><Icon Name="house" /> Accueil</NavLink></li>

    <AuthorizeView Context="mine">
        @if (mine.User.HasClaim("member_linked", "true"))
        {
            <li><NavLink href="me/subscriptions"><Icon Name="clipboard-list" /> Mes inscriptions</NavLink></li>
            <li><NavLink href="me/animations"><Icon Name="chalkboard-user" /> Mes animations</NavLink></li>
            <li><NavLink href="notes"><Icon Name="note-sticky" /> Mes notes</NavLink></li>
        }
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.MemberRead" Context="members">
        <li><NavLink href="members"><Icon Name="users" /> Membres</NavLink></li>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ActivityRead" Context="activities">
        <li><NavLink href="activities"><Icon Name="shapes" /> Activités</NavLink></li>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.EventRead" Context="events">
        <li><NavLink href="events"><Icon Name="calendar-day" /> Événements</NavLink></li>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ProjectRead" Context="projects">
        <li><NavLink href="projects"><Icon Name="diagram-project" /> Projets</NavLink></li>
    </AuthorizeView>

    @* Calendrier : activités (activity.read), événements (event.read) et/ou projets (project.read). *@
    <AuthorizeView Context="calendar">
        @if (Permissions.Has(calendar.User, Permissions.ActivityRead) || Permissions.Has(calendar.User, Permissions.EventRead) || Permissions.Has(calendar.User, Permissions.ProjectRead))
        {
            <li><NavLink href="calendar"><Icon Name="calendar-days" /> Calendrier</NavLink></li>
        }
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.SubscriptionRead" Context="attendance">
        <li><NavLink href="attendance"><Icon Name="clipboard-check" /> Présences</NavLink></li>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.OrganizationRead" Context="organizations">
        <li class="nav-section">Référentiels</li>
        <li><NavLink href="school-years"><Icon Name="graduation-cap" /> Années scolaires</NavLink></li>
        <li><NavLink href="organizations"><Icon Name="building" /> Organisations</NavLink></li>
        <li><NavLink href="holidays"><Icon Name="umbrella-beach" /> Jours fériés</NavLink></li>
        <li><NavLink href="countries"><Icon Name="earth-europe" /> Pays</NavLink></li>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.SpaceRead" Context="spaces">
        <li><NavLink href="spaces"><Icon Name="door-open" /> Espaces</NavLink></li>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.AccessRead" Context="access">
        <li class="nav-section">Contrôle d'accès</li>
        <li><NavLink href="badges"><Icon Name="id-badge" /> Badges</NavLink></li>
    </AuthorizeView>
</ul>
