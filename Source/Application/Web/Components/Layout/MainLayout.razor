@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/"><span>Ada</span><span>Nova</span> <span>83</span></a>

        <div class="topbar-user">
            <AuthorizeView>
                <Authorized>
                    <span>@context.User.Identity?.Name</span>
                    <a href="/api/auth/logout?returnUrl=/" data-enhance-nav="false">Déconnexion</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/api/auth/login?returnUrl=/" data-enhance-nav="false">Connexion</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <nav class="sidebar">
        <NavMenu />
    </nav>

    <main class="content">
        @Body
    </main>
</div>
