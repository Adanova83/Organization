@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/"><span>Ada</span><span>Nova</span> <span>83</span></a>

        <div class="topbar-user">
            <AuthorizeView>
                <Authorized>
                    @* Menu de l'utilisateur : s'ouvre en cliquant sur son nom (élément details, sans JavaScript). *@
                    <details class="user-menu">
                        <summary title="Mon compte">
                            <span class="user-icon" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                            <span class="user-name">@context.User.Identity?.Name</span>
                        </summary>
                        <ul>
                            @if (context.User.HasClaim("member_linked", "true"))
                            {
                                <li><a href="/me/profile"><Icon Name="user" /> Mon profil</a></li>
                            }
                            <li><a href="/api/auth/logout?returnUrl=/" data-enhance-nav="false"><Icon Name="right-from-bracket" /> Déconnexion</a></li>
                        </ul>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <a href="/api/auth/login?returnUrl=/" data-enhance-nav="false">Connexion</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <nav class="sidebar">
        @* Téléphone : menu replié derrière « Menu » (case à cocher, sans JavaScript). *@
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-toggle-label"><Icon Name="bars" Class="when-closed" /><Icon Name="xmark" Class="when-open" /> Menu</label>
        <NavMenu />
    </nav>

    <main class="content">
        @Body
    </main>
</div>

@code {
    /// <summary>Initiales affichées dans la pastille du menu de l'utilisateur (« Admin Adanova » → « AA »).</summary>
    private static string Initials(string? name)
        => string.Concat((name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
