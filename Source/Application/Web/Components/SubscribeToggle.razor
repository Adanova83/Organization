@inject SubscriptionClient Subscriptions
@inject NavigationManager Navigation

@*
    Bouton d'inscription du membre connecté : « S'inscrire », ou « Liste d'attente » si l'élément est complet ;
    une fois inscrit, « Se désinscrire », ou son rang dans la liste d'attente et « Quitter la liste ».
    L'API reste seule juge (doublons, âge, capacité) et vérifie que chacun ne gère que ses propres inscriptions.
*@
@if (MemberId is not null)
{
    @if (Mine is { } mine)
    {
        @if (mine.IsWaiting)
        {
            <span class="waiting">Liste d'attente@(mine.WaitingRank is { } rank ? $" ({Rank(rank)})" : "")</span>
        }
        <form method="post" class="inline" @onsubmit="() => RemoveAsync(mine.Id)" @formname="@UnsubscribeForm">
            <AntiforgeryToken />
            <button type="submit" class="link-button">@(mine.IsWaiting ? "Quitter la liste" : "Se désinscrire")</button>
        </form>
    }
    else if (BlockReason is not null)
    {
        <span class="muted">@BlockReason</span>
    }
    else
    {
        <form method="post" class="inline" @onsubmit="AddAsync" @formname="@SubscribeForm">
            <AntiforgeryToken />
            <button type="submit" class="link-button" title="@(IsFull ? "Complet : vous serez inscrit dès qu'une place se libère" : null)">
                @(IsFull ? "Liste d'attente" : "S'inscrire")
            </button>
        </form>
    }
}

@if (error is not null)
{
    <span class="validation-message">@error</span>
}

@code {
    [Parameter, EditorRequired] public SubscriptionKind Kind { get; set; }
    [Parameter, EditorRequired] public Guid TargetId { get; set; }

    /// <summary>Membre pour lequel on agit (le membre connecté). Nul : rien n'est affiché.</summary>
    [Parameter] public Guid? MemberId { get; set; }

    /// <summary>Inscription existante du membre à cet élément (éventuellement en liste d'attente), s'il y en a une.</summary>
    [Parameter] public SubscriptionItem? Mine { get; set; }

    /// <summary>L'élément est complet : une nouvelle inscription ira en liste d'attente.</summary>
    [Parameter] public bool IsFull { get; set; }

    /// <summary>Si renseigné, l'inscription est impossible et ce texte l'explique (âge minimum, par exemple).</summary>
    [Parameter] public string? BlockReason { get; set; }

    private string? error;

    private string SubscribeForm => $"subscribe-{Kind}-{TargetId}";
    private string UnsubscribeForm => $"unsubscribe-{Kind}-{TargetId}";

    private static string Rank(int rank) => rank == 1 ? "1re" : $"{rank}e";

    private async Task AddAsync()
    {
        try
        {
            await Subscriptions.CreateAsync(Kind, TargetId, MemberId!.Value);
            Navigation.NavigateTo(Navigation.Uri, replace: true);
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task RemoveAsync(Guid subscriptionId)
    {
        try
        {
            await Subscriptions.DeleteAsync(Kind, subscriptionId);
            Navigation.NavigateTo(Navigation.Uri, replace: true);
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }
}
