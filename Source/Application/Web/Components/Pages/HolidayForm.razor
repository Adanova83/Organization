@page "/holidays/new"
@page "/holidays/{Id:guid}/edit"
@attribute [Authorize(Policy = Permissions.OrganizationEdit)]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Nouvelle période" : "Modifier la période")</PageTitle>

<h1>@(IsNew ? "Nouvelle période" : "Modifier la période")</h1>

<p><a href="@BackUrl">← Retour</a></p>

@if (error is not null)
{
    <p class="notice">@error</p>
}

@if (Model is not null)
{
    <EditForm Model="Model" FormName="holiday" OnValidSubmit="SaveAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset>
            <legend>Jour férié ou vacances</legend>
            <label>Nom <InputText @bind-Value="Model.Name" /></label>
            <label>Du <InputDate TValue="DateTime?" @bind-Value="Model.StartDate" /></label>
            <label>Au (inclus) <InputDate TValue="DateTime?" @bind-Value="Model.EndDate" /></label>
            <label>
                Année scolaire (vacances scolaires)
                <InputSelect @bind-Value="Model.SchoolYearId">
                    <option value="">— Aucune (jour férié) —</option>
                    @foreach (var year in schoolYears)
                    {
                        <option value="@year.Id">@year.Code</option>
                    }
                </InputSelect>
            </label>
        </fieldset>

        <p class="actions">
            <button type="submit">Enregistrer</button>
            <a href="@BackUrl">Annuler</a>
        </p>
    </EditForm>

    @if (!IsNew)
    {
        <form method="post" @onsubmit="DeleteAsync" @formname="delete-holiday" class="danger">
            <AntiforgeryToken />
            <button type="submit" class="danger-button" onclick="return confirm('Supprimer cette période ?');">Supprimer cette période</button>
        </form>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromForm(FormName = "holiday")]
    private HolidayModel? Model { get; set; }

    private List<Ct.SchoolYear> schoolYears = [];
    private string? error;

    private bool IsNew => Id is null;
    private string BackUrl => IsNew ? "/holidays" : $"/holidays/{Id}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            schoolYears = await Api.GetSchoolYearsAsync();
            Model ??= IsNew ? new HolidayModel() : HolidayModel.From(await Api.GetByIdAsync<Ct.Holiday>(ApiRoutes.Holidays, Id!.Value));
        }
        catch (Exception ex) when (ApiErrors.IsNotFound(ex))
        {
            Navigation.NavigateTo("/not-found");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateAsync(ApiRoutes.Holidays, Model!.ApplyTo(new Ct.Holiday()));
                Navigation.NavigateTo($"/holidays/{created.Id}");
            }
            else
            {
                var existing = await Api.GetByIdAsync<Ct.Holiday>(ApiRoutes.Holidays, Id!.Value);
                await Api.UpdateAsync(ApiRoutes.Holidays, Id.Value, Model!.ApplyTo(existing));
                Navigation.NavigateTo($"/holidays/{Id}");
            }
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Api.DeleteAsync(ApiRoutes.Holidays, Id!.Value);
            Navigation.NavigateTo("/holidays");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }
}
