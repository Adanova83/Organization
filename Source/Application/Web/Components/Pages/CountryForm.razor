@page "/countries/new"
@page "/countries/{Id:guid}/edit"
@attribute [Authorize(Policy = Permissions.OrganizationEdit)]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Nouveau pays" : "Modifier le pays")</PageTitle>

<h1>@(IsNew ? "Nouveau pays" : "Modifier le pays")</h1>

<p><a href="@BackUrl">← Retour</a></p>

@if (error is not null)
{
    <p class="notice">@error</p>
}

@if (Model is not null)
{
    <EditForm Model="Model" FormName="country" OnValidSubmit="SaveAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset>
            <legend>Pays</legend>
            <label>Nom <InputText @bind-Value="Model.Name" /></label>
            <label>Code ISO à 2 lettres (FR) <InputText @bind-Value="Model.CodeAlpha2" maxlength="2" /></label>
            <label>Code ISO à 3 lettres (FRA) <InputText @bind-Value="Model.CodeAlpha3" maxlength="3" /></label>
        </fieldset>

        <p class="actions">
            <button type="submit">Enregistrer</button>
            <a href="@BackUrl">Annuler</a>
        </p>
    </EditForm>

    @if (!IsNew)
    {
        <form method="post" @onsubmit="DeleteAsync" @formname="delete-country" class="danger">
            <AntiforgeryToken />
            <button type="submit" class="danger-button" onclick="return confirm('Supprimer ce pays ?');">Supprimer ce pays</button>
        </form>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromForm(FormName = "country")]
    private CountryModel? Model { get; set; }

    private string? error;

    private bool IsNew => Id is null;
    private string BackUrl => IsNew ? "/countries" : $"/countries/{Id}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model ??= IsNew ? new CountryModel() : CountryModel.From(await Api.GetByIdAsync<Ct.Country>(ApiRoutes.Countries, Id!.Value));
        }
        catch (Exception ex) when (ApiErrors.IsNotFound(ex))
        {
            Navigation.NavigateTo("/not-found");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateAsync(ApiRoutes.Countries, Model!.ApplyTo(new Ct.Country()));
                Navigation.NavigateTo($"/countries/{created.Id}");
            }
            else
            {
                var existing = await Api.GetByIdAsync<Ct.Country>(ApiRoutes.Countries, Id!.Value);
                await Api.UpdateAsync(ApiRoutes.Countries, Id.Value, Model!.ApplyTo(existing));
                Navigation.NavigateTo($"/countries/{Id}");
            }
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Api.DeleteAsync(ApiRoutes.Countries, Id!.Value);
            Navigation.NavigateTo("/countries");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }
}
