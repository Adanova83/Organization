@page "/projects"
@attribute [Authorize(Policy = Permissions.ProjectRead)]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject UserAccess Access

<PageTitle>Projets</PageTitle>

<h1>Projets</h1>

@if (canEdit)
{
    <p><a class="button" href="/projects/new">Nouveau projet</a></p>
}

<form method="get" action="/projects" class="search">
    <input type="search" name="query" value="@Query" placeholder="Nom ou code" aria-label="Rechercher un projet" />
    <button type="submit">Rechercher</button>
</form>

@if (error is not null)
{
    <p class="notice">@error</p>
}
else if (result is not null)
{
    @if (result.Data.Count == 0)
    {
        <p class="muted">Aucun projet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Projet</th>
                    <th>Année</th>
                    <th>Période</th>
                    <th>Âge</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in result.Data)
                {
                    <tr>
                        <td><a href="/projects/@project.Id">@project.Name</a></td>
                        <td>@project.SchoolYearCode</td>
                        <td>@Format.Period(project.EffectiveStartDate, project.EffectiveEndDate)</td>
                        <td>@Format.Age(project.AgeMinimum)</td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="pager">
            @if (CurrentPage > 1)
            {
                <a href="@PageUrl(CurrentPage - 1)">← Précédent</a>
            }
            <span>Page @CurrentPage / @PageCount · @result.FilteredCount projet(s)</span>
            @if (CurrentPage < PageCount)
            {
                <a href="@PageUrl(CurrentPage + 1)">Suivant →</a>
            }
        </p>
    }
}

@code {
    private const int PageSize = 25;

    [SupplyParameterFromQuery] public string? Query { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }

    private PagedResponse<Ct.Project>? result;
    private string? error;
    private bool canEdit;

    private int CurrentPage => Math.Max(Page ?? 1, 1);
    private int PageCount => result is null ? 1 : Math.Max((int)Math.Ceiling(result.FilteredCount / (double)PageSize), 1);

    private string PageUrl(int page)
        => "/projects?" + (string.IsNullOrWhiteSpace(Query) ? "" : "query=" + Uri.EscapeDataString(Query) + "&") + "page=" + page;

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Access.CanAsync(Permissions.ProjectEdit);

        try
        {
            result = await Api.GetProjectsAsync(Query, CurrentPage, PageSize);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/api/auth/login?returnUrl=/projects", forceLoad: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "L'API est injoignable.";
        }
    }
}
