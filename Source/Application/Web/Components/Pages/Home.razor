@page "/"

<PageTitle>Accueil</PageTitle>

<h1>Accueil</h1>

<AuthorizeView>
    <Authorized>
        @if (context.User.HasClaim("member_linked", "false"))
        {
            <p class="notice">
                Votre compte est connecté, mais aucun membre ne lui est rattaché. Demandez à un administrateur de créer
                un membre avec l'adresse e-mail de votre compte.
            </p>
        }
        else
        {
            <p>Bonjour <strong>@context.User.Identity?.Name</strong>.</p>
            <Dashboard />
        }
    </Authorized>
    <NotAuthorized>
        <p>Vous n'êtes pas connecté.</p>
        <p><a class="button" href="/api/auth/login?returnUrl=/" data-enhance-nav="false">Se connecter</a></p>
    </NotAuthorized>
</AuthorizeView>
