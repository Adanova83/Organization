@page "/projects/{Id:guid}"
@attribute [Authorize(Policy = Permissions.ProjectRead)]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject UserAccess Access
@inject SubscriptionClient Subs

<PageTitle>@(project?.Name ?? "Projet")</PageTitle>

<p><a href="/projects"><Icon Name="arrow-left" /> Retour aux projets</a></p>

@if (error is not null)
{
    <p class="notice">@error</p>
}
else if (project is not null)
{
    <h1>@project.Name</h1>

    @if (canEdit)
    {
        <p class="actions">
            <a class="button" href="/projects/@Id/edit"><Icon Name="pen" /> Modifier le projet</a>
            <a class="button" href="/projects/@Id/slots/new"><Icon Name="plus" /> Nouveau créneau</a>
        </p>
    }

    <dl class="meta">
        <dt>Code</dt><dd>@project.Code</dd>
        <dt>Année scolaire</dt><dd>@project.SchoolYearCode</dd>
        <dt>Période</dt><dd>@Format.Period(project.EffectiveStartDate, project.EffectiveEndDate)@(project.StartDate is not null || project.EndDate is not null ? " (période restreinte)" : "")</dd>
        <dt>Rythme</dt><dd>@Library.Domain.SessionSchedule.Label(project.DuringTermTime, project.DuringSchoolHolidays)</dd>
        <dt>Âge</dt><dd>@Format.Age(project.AgeMinimum)</dd>
        @if (!string.IsNullOrWhiteSpace(project.Description))
        {
            <dt>Description</dt>
            <dd>@project.Description</dd>
        }
    </dl>

    <h2>Créneaux</h2>

    @if (slots.Count == 0)
    {
        <p class="muted">Aucun créneau.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Jour</th><th>Horaires</th><th>Lieu</th><th>Places</th><th>Animateurs</th>@if (showSubscriptions){<th>Inscription</th>}@if (canEdit){<th></th>}</tr>
            </thead>
            <tbody>
                @foreach (var slot in slots.OrderBy(s => s.DayOfWeek).ThenBy(s => s.StartTime))
                {
                    <tr>
                        <td>@Format.Day(slot.DayOfWeek)</td>
                        <td>@Format.Time(slot.StartTime) – @Format.Time(slot.EndTime)</td>
                        <td>@(slot.SpaceId is { } space && spaces.TryGetValue(space, out var name) ? name : "—")</td>
                        <td>@Format.Places(slot.Capacity, AvailabilityOf(slot.Id))</td>
                        <td><a href="/animations/project/@slot.Id">Voir</a></td>
                        @if (showSubscriptions)
                        {
                            <td>
                                <div class="subscription-cell">
                                <SubscribeToggle Kind="SubscriptionKind.Project" TargetId="slot.Id" MemberId="me"
                                                 Mine="SubscriptionOf(slot.Id)" IsFull="IsFull(slot.Id)" BlockReason="@BlockReason" />
                                @if (canSeeSubscribers)
                                {
                                    <a href="/subscriptions/project/@slot.Id">Inscrits</a>
                                }
                                </div>
                            </td>
                        }
                        @if (canEdit)
                        {
                            <td><RowActions EditUrl="@($"/project-slots/{slot.Id}/edit")" DeleteRoute="@ApiRoutes.ProjectSlots" Id="slot.Id" Confirm="Supprimer ce créneau, avec ses inscriptions et animateurs ?" /></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Ct.Project? project;
    private List<Ct.ProjectSlot> slots = [];
    private Dictionary<Guid, string> spaces = [];
    private string? error;
    private bool canEdit;
    private bool canSeeSubscribers;
    // Responsable : l'API le laisse déroger à l'âge et à la capacité, le bouton n'est donc pas bloqué.
    private bool canOverride;
    private Guid? me;
    private DateOnly? myBirthdate;
    private Dictionary<Guid, SubscriptionItem> mySubscriptions = [];
    private Dictionary<Guid, Ct.SubscriptionAvailability> availability = [];

    private bool showSubscriptions => me is not null || canSeeSubscribers;

    private SubscriptionItem? SubscriptionOf(Guid slotId) => mySubscriptions.GetValueOrDefault(slotId);

    private Ct.SubscriptionAvailability? AvailabilityOf(Guid slotId) => availability.GetValueOrDefault(slotId);

    // Complet : liste d'attente, sauf pour un responsable (inscription directe).
    private bool IsFull(Guid slotId) => !canOverride && AvailabilityOf(slotId)?.IsFull == true;

    // Âge apprécié au début du projet (règle de l'API).
    private string? BlockReason => canOverride ? null : SubscriptionHints.AgeBlock(project?.AgeMinimum, myBirthdate, project?.EffectiveStartDate);

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Access.CanAsync(Permissions.ProjectEdit);

        try
        {
            project = await Api.GetProjectAsync(Id);
            slots = await Api.GetProjectSlotsAsync(Id);

            canSeeSubscribers = await Access.CanAsync(Permissions.SubscriptionRead);
            canOverride = await Access.CanAsync(Permissions.SubscriptionEdit);
            me = await Access.MemberIdAsync();
            myBirthdate = await Access.BirthdateAsync();
            if (me is { } memberId)
            {
                mySubscriptions = (await Subs.ListAsync(SubscriptionKind.Project, null, memberId)).ToDictionary(item => item.TargetId);
            }

            spaces = await Api.GetSpaceNamesAsync();
            availability = await Subs.AvailabilityAsync(SubscriptionKind.Project, slots.Select(s => s.Id));
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Navigation.NavigateTo("/not-found");
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/api/auth/login?returnUrl=/projects/{Id}", forceLoad: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "L'API est injoignable.";
        }
    }
}
