@page "/members"
@attribute [Authorize(Policy = Permissions.MemberRead)]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthState

<PageTitle>Membres</PageTitle>

<h1>Membres</h1>

@if (canEdit)
{
    <p><a class="button" href="/members/new">Nouveau membre</a></p>
}

<form method="get" action="/members" class="search">
    <input type="search" name="query" value="@Query" placeholder="Nom, prénom, e-mail" aria-label="Rechercher un membre" />
    <button type="submit">Rechercher</button>
</form>

@if (error is not null)
{
    <p class="notice">@error</p>
}
else if (result is not null)
{
    @if (result.Data.Count == 0)
    {
        <p class="muted">Aucun membre.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>E-mail</th>
                    <th>Téléphone</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in result.Data)
                {
                    <tr>
                        <td><a href="/members/@member.Id">@member.Lastname @member.Firstname</a></td>
                        <td>@member.Email</td>
                        <td>@member.PhoneNumber</td>
                        <td>@(member.Active?.IsActive == false ? "Inactif" : "Actif")</td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="pager">
            @if (CurrentPage > 1)
            {
                <a href="@PageUrl(CurrentPage - 1)">← Précédent</a>
            }
            <span>Page @CurrentPage / @PageCount · @result.FilteredCount membre(s)</span>
            @if (CurrentPage < PageCount)
            {
                <a href="@PageUrl(CurrentPage + 1)">Suivant →</a>
            }
        </p>
    }
}

@code {
    private const int PageSize = 25;

    [SupplyParameterFromQuery] public string? Query { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }

    private PagedResponse<Ct.Member>? result;
    private string? error;
    private bool canEdit;

    private int CurrentPage => Math.Max(Page ?? 1, 1);

    private int PageCount => result is null ? 1 : Math.Max((int)Math.Ceiling(result.FilteredCount / (double)PageSize), 1);

    private string PageUrl(int page)
        => "/members?" + (string.IsNullOrWhiteSpace(Query) ? "" : "query=" + Uri.EscapeDataString(Query) + "&") + "page=" + page;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        canEdit = (await Authorization.AuthorizeAsync(user, Permissions.MemberEdit)).Succeeded;

        try
        {
            result = await Api.GetMembersAsync(Query, CurrentPage, PageSize);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // Session expirée : on se reconnecte puis on revient ici.
            Navigation.NavigateTo("/api/auth/login?returnUrl=" + Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri).Insert(0, "/")), forceLoad: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "L'API est injoignable.";
        }
    }
}
