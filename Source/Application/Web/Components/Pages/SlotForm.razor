@page "/activity-sessions/{SessionId:guid}/slots/new"
@page "/activity-session-slots/{Id:guid}/edit"
@attribute [Authorize(Policy = Permissions.ActivityEdit)]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Nouveau créneau" : "Modifier le créneau")</PageTitle>

<h1>@(IsNew ? "Nouveau créneau" : "Modifier le créneau")</h1>

<p><a href="/activities/@activityId">← Retour à l'activité</a></p>

@if (error is not null)
{
    <p class="notice">@error</p>
}

@if (Model is not null)
{
    <EditForm Model="Model" FormName="slot" OnValidSubmit="SaveAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset>
            <legend>Créneau</legend>
            <label>
                Jour
                <InputSelect @bind-Value="Model.DayOfWeek">
                    @foreach (var day in new[] { 1, 2, 3, 4, 5, 6, 0 })
                    {
                        <option value="@day">@Format.Day(day)</option>
                    }
                </InputSelect>
            </label>
            <label>Début <InputText type="time" @bind-Value="Model.StartTime" /></label>
            <label>Fin <InputText type="time" @bind-Value="Model.EndTime" /></label>
            <label>Fréquence (en semaines : 1 = chaque semaine) <InputNumber @bind-Value="Model.Frequency" /></label>
            <label>
                Lieu
                <InputSelect @bind-Value="Model.SpaceId">
                    <option value="">— Aucun —</option>
                    @foreach (var space in spaces)
                    {
                        <option value="@space.Id">@space.Name</option>
                    }
                </InputSelect>
            </label>
        </fieldset>

        <p class="actions">
            <button type="submit">Enregistrer</button>
            <a href="/activities/@activityId">Annuler</a>
        </p>
    </EditForm>

    @if (!IsNew)
    {
        <form method="post" @onsubmit="DeleteAsync" @formname="delete-slot" class="danger">
            <AntiforgeryToken />
            <button type="submit" class="danger-button" onclick="return confirm('Supprimer ce créneau ?');">Supprimer ce créneau</button>
        </form>
    }
}

@code {
    [Parameter] public Guid? SessionId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromForm(FormName = "slot")]
    private SlotModel? Model { get; set; }

    private List<Ct.Space> spaces = [];
    private Guid sessionId;
    private Guid activityId;
    private string? error;

    private bool IsNew => Id is null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Ct.ActivitySessionSlot? existing = null;
            if (!IsNew)
            {
                existing = await Api.GetByIdAsync<Ct.ActivitySessionSlot>(ApiRoutes.ActivitySessionSlots, Id!.Value);
            }

            sessionId = SessionId ?? existing!.SessionId;
            activityId = (await Api.GetByIdAsync<Ct.ActivitySession>(ApiRoutes.ActivitySessions, sessionId)).ActivityId;
            spaces = (await Api.GetSpacesAsync()).OrderBy(s => s.Name).ToList();

            if (Model is null)
            {
                Model = existing is null ? new SlotModel() : SlotModel.From(existing);
            }
        }
        catch (Exception ex) when (ApiErrors.IsNotFound(ex))
        {
            Navigation.NavigateTo("/not-found");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (IsNew)
            {
                var slot = Model!.ApplyTo(new Ct.ActivitySessionSlot { SessionId = sessionId });
                await Api.CreateAsync(ApiRoutes.ActivitySessionSlots, slot);
            }
            else
            {
                var existing = await Api.GetByIdAsync<Ct.ActivitySessionSlot>(ApiRoutes.ActivitySessionSlots, Id!.Value);
                await Api.UpdateAsync(ApiRoutes.ActivitySessionSlots, Id.Value, Model!.ApplyTo(existing));
            }

            Navigation.NavigateTo($"/activities/{activityId}");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Api.DeleteAsync(ApiRoutes.ActivitySessionSlots, Id!.Value);
            Navigation.NavigateTo($"/activities/{activityId}");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }
}
