@page "/activities"
@attribute [Authorize(Policy = Permissions.ActivityRead)]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject UserAccess Access

<PageTitle>Activités</PageTitle>

<h1>Activités</h1>

@if (canEdit)
{
    <p><a class="button" href="/activities/new"><Icon Name="plus" /> Nouvelle activité</a></p>
}

<form method="get" action="/activities" class="search">
    <input type="search" name="query" value="@Query" placeholder="Nom ou code" aria-label="Rechercher une activité" />
    <button type="submit"><Icon Name="magnifying-glass" /> Rechercher</button>
</form>

@if (error is not null)
{
    <p class="notice">@error</p>
}
else if (result is not null)
{
    @if (result.Data.Count == 0)
    {
        <p class="muted">Aucune activité.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Activité</th>
                    <th>Code</th>
                    <th>Âge</th>
                    <th>Statut</th>@if (canEdit){<th></th>}
                </tr>
            </thead>
            <tbody>
                @foreach (var activity in result.Data)
                {
                    <tr>
                        <td><a href="/activities/@activity.Id">@activity.Name</a></td>
                        <td>@activity.Code</td>
                        <td>@Format.Age(activity.AgeMinimum)</td>
                        <td>@(activity.Active?.IsActive == false ? "Inactive" : "Active")</td>
                        @if (canEdit)
                        {
                            <td><RowActions EditUrl="@($"/activities/{activity.Id}/edit")" DeleteRoute="@ApiRoutes.Activities" Id="activity.Id" Confirm="Supprimer cette activité, avec ses sessions, créneaux, inscriptions et animateurs ?" /></td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <p class="pager">
            @if (CurrentPage > 1)
            {
                <a href="@PageUrl(CurrentPage - 1)"><Icon Name="arrow-left" /> Précédent</a>
            }
            <span>Page @CurrentPage / @PageCount · @result.FilteredCount activité(s)</span>
            @if (CurrentPage < PageCount)
            {
                <a href="@PageUrl(CurrentPage + 1)">Suivant <Icon Name="arrow-right" /></a>
            }
        </p>
    }
}

@code {
    private const int PageSize = 25;

    [SupplyParameterFromQuery] public string? Query { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }

    private PagedResponse<Ct.Activity>? result;
    private string? error;
    private bool canEdit;

    private int CurrentPage => Math.Max(Page ?? 1, 1);
    private int PageCount => result is null ? 1 : Math.Max((int)Math.Ceiling(result.FilteredCount / (double)PageSize), 1);

    private string PageUrl(int page)
        => "/activities?" + (string.IsNullOrWhiteSpace(Query) ? "" : "query=" + Uri.EscapeDataString(Query) + "&") + "page=" + page;

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Access.CanAsync(Permissions.ActivityEdit);

        try
        {
            result = await Api.GetActivitiesAsync(Query, CurrentPage, PageSize);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/api/auth/login?returnUrl=/activities", forceLoad: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "L'API est injoignable.";
        }
    }
}
