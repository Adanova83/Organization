@page "/activities/new"
@page "/activities/{Id:guid}/edit"
@attribute [Authorize(Policy = Permissions.ActivityEdit)]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Nouvelle activité" : "Modifier l'activité")</PageTitle>

<h1>@(IsNew ? "Nouvelle activité" : "Modifier l'activité")</h1>

<p><a href="@(IsNew ? "/activities" : $"/activities/{Id}")">← Retour</a></p>

@if (error is not null)
{
    <p class="notice">@error</p>
}

@if (Model is not null)
{
    <EditForm Model="Model" FormName="activity" OnValidSubmit="SaveAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset>
            <legend>Activité</legend>
            <label>Nom <InputText @bind-Value="Model.Name" /></label>
            <label>Code <InputText @bind-Value="Model.Code" /></label>
            <label>Description <InputTextArea @bind-Value="Model.Description" rows="4" /></label>
            <label>Âge minimum <InputNumber @bind-Value="Model.AgeMinimum" /></label>
            <label>Couleur (calendrier) <InputText type="color" @bind-Value="Model.Color" class="color" /></label>
            <label>
                Organisation
                <InputSelect @bind-Value="Model.OrganizationId">
                    <option value="">— Choisir —</option>
                    @foreach (var organization in organizations)
                    {
                        <option value="@organization.Id">@organization.Name</option>
                    }
                </InputSelect>
            </label>
        </fieldset>

        <p class="actions">
            <button type="submit">Enregistrer</button>
            <a href="@(IsNew ? "/activities" : $"/activities/{Id}")">Annuler</a>
        </p>
    </EditForm>

    @if (!IsNew)
    {
        <form method="post" @onsubmit="DeleteAsync" @formname="delete-activity" class="danger">
            <AntiforgeryToken />
            <button type="submit" class="danger-button" onclick="return confirm('Supprimer cette activité ?');">Supprimer cette activité</button>
        </form>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromForm(FormName = "activity")]
    private ActivityModel? Model { get; set; }

    private List<Ct.Organization> organizations = [];
    private string? error;

    private bool IsNew => Id is null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            organizations = await Api.GetOrganizationsAsync();

            if (Model is null)
            {
                Model = IsNew ? new ActivityModel() : ActivityModel.From(await Api.GetByIdAsync<Ct.Activity>(ApiRoutes.Activities, Id!.Value));
            }
        }
        catch (Exception ex) when (ApiErrors.IsNotFound(ex))
        {
            Navigation.NavigateTo("/not-found");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex) + (organizations.Count == 0 ? " La liste des organisations (permission organization.read) est nécessaire." : "");
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateAsync(ApiRoutes.Activities, Model!.ApplyTo(new Ct.Activity()));
                Navigation.NavigateTo($"/activities/{created.Id}");
            }
            else
            {
                var existing = await Api.GetByIdAsync<Ct.Activity>(ApiRoutes.Activities, Id!.Value);
                await Api.UpdateAsync(ApiRoutes.Activities, Id.Value, Model!.ApplyTo(existing));
                Navigation.NavigateTo($"/activities/{Id}");
            }
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Api.DeleteAsync(ApiRoutes.Activities, Id!.Value);
            Navigation.NavigateTo("/activities");
        }
        catch (Exception ex) when (ApiErrors.IsApi(ex))
        {
            error = ApiErrors.Message(ex);
        }
    }
}
