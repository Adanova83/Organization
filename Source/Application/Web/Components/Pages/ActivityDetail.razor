@page "/activities/{Id:guid}"
@attribute [Authorize(Policy = Permissions.ActivityRead)]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject UserAccess Access
@inject SubscriptionClient Subs

<PageTitle>@(activity?.Name ?? "Activité")</PageTitle>

<p><a href="/activities"><Icon Name="arrow-left" /> Retour aux activités</a></p>

@if (error is not null)
{
    <p class="notice">@error</p>
}
else if (activity is not null)
{
    <h1>@activity.Name</h1>

    @if (canEdit)
    {
        <p class="actions">
            <a class="button" href="/activities/@Id/edit"><Icon Name="pen" /> Modifier l'activité</a>
            <a class="button" href="/activities/@Id/sessions/new"><Icon Name="plus" /> Nouvelle session</a>
        </p>
    }

    <dl class="meta">
        <dt>Code</dt><dd>@activity.Code</dd>
        <dt>Âge</dt><dd>@Format.Age(activity.AgeMinimum)</dd>
        @if (!string.IsNullOrWhiteSpace(activity.Description))
        {
            <dt>Description</dt>
            <dd>@activity.Description</dd>
        }
    </dl>

    <h2>Sessions et créneaux</h2>

    @if (sessions.Count == 0)
    {
        <p class="muted">Aucune session.</p>
    }

    @foreach (var item in sessions)
    {
        <section class="card">
            <h2>Année @item.Session.SchoolYearCode</h2>
            <p class="muted">
                @Format.Period(item.Session.EffectiveStartDate, item.Session.EffectiveEndDate)@(item.Session.StartDate is not null || item.Session.EndDate is not null ? " (période restreinte)" : "")
                · @Library.Domain.SessionSchedule.Label(item.Session.DuringTermTime, item.Session.DuringSchoolHolidays)
                · Tarif : @Format.Price(item.Session.Price)
            </p>

            @if (canEdit)
            {
                <p class="actions">
                    <a class="button" href="/activity-sessions/@item.Session.Id/slots/new"><Icon Name="plus" /> Nouveau créneau</a>
                    <RowActions EditUrl="@($"/activity-sessions/{item.Session.Id}/edit")" DeleteRoute="@ApiRoutes.ActivitySessions" Id="item.Session.Id" Confirm="Supprimer cette session, avec ses créneaux, inscriptions et animateurs ?" />
                </p>
            }

            @if (item.Slots.Count == 0)
            {
                <p class="muted">Aucun créneau.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr><th>Jour</th><th>Horaires</th><th>Fréquence</th><th>Lieu</th><th>Places</th><th>Animateurs</th>@if (showSubscriptions){<th>Inscription</th>}@if (canEdit){<th></th>}</tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in item.Slots.OrderBy(s => s.DayOfWeek).ThenBy(s => s.StartTime))
                        {
                            <tr>
                                <td>@Format.Day(slot.DayOfWeek)</td>
                                <td>@Format.Time(slot.StartTime) – @Format.Time(slot.EndTime)</td>
                                <td>@Format.Frequency(slot.Frequency)</td>
                                <td>@SpaceName(slot.SpaceId)</td>
                                <td>@Format.Places(slot.Capacity, AvailabilityOf(slot.Id))</td>
                                <td><a href="/animations/slot/@slot.Id">Voir</a></td>
                                @if (showSubscriptions)
                                {
                                    <td>
                                        <div class="subscription-cell">
                                        <SubscribeToggle Kind="SubscriptionKind.Slot" TargetId="slot.Id" MemberId="me"
                                                         Mine="SubscriptionOf(slot.Id)" IsFull="IsFull(slot.Id)" BlockReason="@BlockReasonFor(item.Session)" />
                                        @if (canSeeSubscribers)
                                        {
                                            <a href="/subscriptions/slot/@slot.Id">Inscrits</a>
                                            <a href="@AttendanceRoutes.Sessions(slot.Id)">Présences</a>
                                        }
                                        </div>
                                    </td>
                                }
                                @if (canEdit)
                                {
                                    <td><RowActions EditUrl="@($"/activity-session-slots/{slot.Id}/edit")" DeleteRoute="@ApiRoutes.ActivitySessionSlots" Id="slot.Id" Confirm="Supprimer ce créneau, avec ses inscriptions et animateurs ?" /></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
}

@code {
    private sealed record SessionView(Ct.ActivitySession Session, IReadOnlyList<Ct.ActivitySessionSlot> Slots);

    [Parameter] public Guid Id { get; set; }

    private Ct.Activity? activity;
    private List<SessionView> sessions = [];
    private Dictionary<Guid, string> spaces = [];
    private string? error;
    private bool canEdit;
    private bool canSeeSubscribers;
    // Responsable : l'API le laisse déroger à l'âge et à la capacité, le bouton n'est donc pas bloqué.
    private bool canOverride;
    private Guid? me;
    private DateOnly? myBirthdate;
    private Dictionary<Guid, SubscriptionItem> mySubscriptions = [];
    private Dictionary<Guid, Ct.SubscriptionAvailability> availability = [];

    private bool showSubscriptions => me is not null || canSeeSubscribers;

    private SubscriptionItem? SubscriptionOf(Guid slotId) => mySubscriptions.GetValueOrDefault(slotId);

    private Ct.SubscriptionAvailability? AvailabilityOf(Guid slotId) => availability.GetValueOrDefault(slotId);

    // Complet : liste d'attente, sauf pour un responsable (inscription directe).
    private bool IsFull(Guid slotId) => !canOverride && AvailabilityOf(slotId)?.IsFull == true;

    // Âge apprécié au début de la session (règle de l'API).
    private string? BlockReasonFor(Ct.ActivitySession session)
        => canOverride ? null : SubscriptionHints.AgeBlock(activity?.AgeMinimum, myBirthdate, session.EffectiveStartDate);

    private string SpaceName(Guid? id) => id is { } key && spaces.TryGetValue(key, out var name) ? name : "—";

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Access.CanAsync(Permissions.ActivityEdit);

        try
        {
            activity = await Api.GetActivityAsync(Id);

            canSeeSubscribers = await Access.CanAsync(Permissions.SubscriptionRead);
            canOverride = await Access.CanAsync(Permissions.SubscriptionEdit);
            me = await Access.MemberIdAsync();
            myBirthdate = await Access.BirthdateAsync();
            if (me is { } memberId)
            {
                mySubscriptions = (await Subs.ListAsync(SubscriptionKind.Slot, null, memberId)).ToDictionary(item => item.TargetId);
            }

            spaces = await Api.GetSpaceNamesAsync();

            var list = await Api.GetActivitySessionsAsync(Id);
            foreach (var session in list.OrderByDescending(s => s.StartDate))
            {
                sessions.Add(new SessionView(session, await Api.GetActivitySessionSlotsAsync(session.Id)));
            }

            // Places occupées de tous les créneaux (sans les noms).
            availability = await Subs.AvailabilityAsync(SubscriptionKind.Slot, sessions.SelectMany(s => s.Slots).Select(s => s.Id));
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Navigation.NavigateTo("/not-found");
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/api/auth/login?returnUrl=/activities/{Id}", forceLoad: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "L'API est injoignable.";
        }
    }
}
