@page "/Login"
@using Application.Server.Components.Dialog
@using Application.Server.Components.Layout
@using ASA = Application.Server.Authentication
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ASA.PendingReturnUrl PendingReturnUrl

@attribute [AllowAnonymous]
@layout MainLayout
@rendermode InteractiveServer

<LoginPageInit />

<style>
    .blur-background { backdrop-filter: blur(10px); }
</style>

@code {
    private bool _dialogOpened = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialogOpened) return;
        _dialogOpened = true;

        var returnUrl = PendingReturnUrl.Value ?? "/";
        PendingReturnUrl.Value = null; // Vider après lecture
        Console.WriteLine($"ReturnUrl final = {returnUrl}");

        await Task.Delay(300);

        var parameters = new DialogParameters
        {
            { nameof(LoginDialog.ReturnUrl), returnUrl }
        };

        DialogOptions options = new()
        {
            BackgroundClass = "blur-background",
            CloseOnEscapeKey = false,
            BackdropClick = false
        };

        try
        {
            var dialog = await DialogService.ShowAsync<LoginDialog>("Connexion", parameters, options);
            var result = await dialog.Result;
            if (result is null || result.Canceled)
                Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERREUR : {ex.GetType().Name} - {ex.Message}");
        }
    }
}