{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "adanova",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": "membre",
          "claims": {
            "sub": "dev-membre",
            "email": "membre.test@adanova83.org",
            "email_verified": true,
            "name": "Membre Test",
            "groups": ["membres"]
          }
        },
        {
          "requestParam": "grant_type",
          "match": "*",
          "claims": {
            "sub": "dev-admin",
            "email": "adanova83@adanova83.org",
            "email_verified": true,
            "name": "Admin Adanova",
            "groups": ["authentik Admins"]
          }
        }
      ]
    }
  ]
}
