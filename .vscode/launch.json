    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Source/Application/Application.Server/bin/Debug/net8.0/Application.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Source/Application/Application.Server/",
            "stopAtEntry": false,
            "justMyCode": false,
            "logging": {
                "moduleLoad": false
            },
            "launchSettingsFilePath": "${workspaceFolder}/Source/Application/Application.Server/Properties/launchSettings.json",
            "launchSettingsProfile": "http",
            "suppressJITOptimizations": true,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_CONTENTROOT": "${workspaceFolder}/Source/Application/Application.Server/"
            }
        }
    ]
}