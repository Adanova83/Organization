{
    // Débogage local de l'API et du site web.
    // Prérequis : la base et le faux serveur OIDC tournent dans Docker, mais pas les conteneurs api et web (mêmes ports) :
    //   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db oidc
    // Les autres variables (DB_PASSWORD, API_KEY, ADMIN_EMAIL...) viennent du fichier .env à la racine.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Source/Application/Api/bin/Debug/net10.0/Api.dll",
            "cwd": "${workspaceFolder}/Source/Application/Api/",
            "stopAtEntry": false,
            "justMyCode": false,
            "suppressJITOptimizations": true,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5180",
                "DB_HOST": "localhost",
                "DB_PORT": "5432",
                "Migrations__ApplyAtStartup": "true",
                "Oidc__Authority": "http://host.docker.internal:8081/adanova",
                "Oidc__RequireHttpsMetadata": "false",
                "Oidc__ClientId": "organizations-web",
                "Oidc__ClientSecret": "dev-secret"
            }
        },
        {
            "name": "Site web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Source/Application/Web/bin/Debug/net10.0/Web.dll",
            "cwd": "${workspaceFolder}/Source/Application/Web/",
            "stopAtEntry": false,
            "justMyCode": false,
            "suppressJITOptimizations": true,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5200"
            }
        }
    ],
    "compounds": [
        {
            "name": "API + site web",
            "configurations": ["API", "Site web"],
            "stopAll": true
        }
    ]
}
