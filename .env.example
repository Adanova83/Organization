# Copier ce fichier en .env (non versionné) à la racine du dépôt.
DB_NAME=adanova
DB_USER=adanova
DB_PASSWORD=change-me
# Clé attendue dans l'en-tête X-Api-Key
API_KEY=change-me

# Premier compte administrateur global.
# L'API crée au démarrage le membre portant cet e-mail ; à sa première connexion, il est rattaché à son compte
# de l'annuaire. Les membres du groupe ADMIN_GROUP de l'annuaire ont toutes les permissions.
ADMIN_EMAIL=admin@adanova83.org
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=Adanova
# ADMIN_GROUP=authentik Admins
# Mot de passe du compte : défini dans l'annuaire, jamais lu ni stocké par l'API (donc non transmis à son conteneur).
# Il sera utilisé par le compose global pour créer le compte initial d'Authentik :
#   AUTHENTIK_BOOTSTRAP_EMAIL=${ADMIN_EMAIL}   AUTHENTIK_BOOTSTRAP_PASSWORD=${ADMIN_PASSWORD}
ADMIN_PASSWORD=change-me-long-and-random

# Authentification OIDC (laisser vide pour la désactiver)
# OIDC_AUTHORITY=https://auth.adanova83.org/realms/adanova
# OIDC_AUDIENCE=organizations-api
# Connexion du site web (l'API mène le flux OIDC avec l'annuaire et remet un cookie de session)
# Authentik : fournisseur OAuth2/OpenID « confidential », redirect URI https://<domaine>/api/auth/callback,
# scopes openid, profile, email ; le claim « groups » doit figurer dans le jeton d'identité.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Fermer aussi la session de l'annuaire à la déconnexion (SSO)
# SESSION_END_PROVIDER_ON_LOGOUT=false

# Flux ICS du planning pour Nextcloud (laisser vide pour les désactiver)
# Générer un secret long, par exemple : openssl rand -hex 32
# CALENDAR_FEED_TOKEN=

# Optionnel
# Clé d'API acceptée sur les endpoints métier (true par défaut dans Docker ; false en production)
# API_ALLOW_KEY_ON_BUSINESS=true
# Documentation Swagger sur /swagger (true par défaut dans Docker ; false en production)
# API_ENABLE_SWAGGER=true
# API_PORT=5180
# Port du site web (Blazor) ; en production, seul le site (ou Traefik) est exposé
# WEB_PORT=5200
# Nom du cookie de session (identique pour l'API et le site)
# SESSION_COOKIE_NAME=adanova.session
# DB_HOST_PORT=5432
# ASPNETCORE_ENVIRONMENT=Production
# Mettre à true pour que l'API crée les tables (et le membre administrateur) au démarrage
# MIGRATIONS_APPLY_AT_STARTUP=true
